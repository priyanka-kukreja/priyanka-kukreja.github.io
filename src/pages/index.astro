---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

function readTime(body: string) {
  const words = body.trim().split(/\s+/).length;
  return Math.max(1, Math.round(words / 220));
}
---

<BaseLayout
  title="Priyanka Kukreja"
  description="Product Leader at CodeRabbit. Building 0→1 AI products. Previously Stripe, Meta."
>
  <section class="container-wide pt-20 md:pt-28 pb-20">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16 items-center">
      <div class="md:col-span-4">
        <img
          src="/profile-placeholder.svg"
          alt="Priyanka Kukreja"
          width="320"
          height="400"
          class="w-full max-w-[320px] aspect-[4/5] object-cover rounded-sm border border-rule"
        />
      </div>
      <div class="md:col-span-8">
        <p class="eyebrow mb-5">Product Leader · CodeRabbit</p>
        <h1 class="text-[2.6rem] md:text-[3.4rem] leading-[1.05] tracking-tight">
          Building the products
          <br />that bend the curve of AI.
        </h1>
        <p class="mt-7 text-lg md:text-xl text-ink/80 leading-relaxed max-w-2xl">
          I lead product at a Series B AI company, where my team is building
          0→1 products that put AI to work for engineers. Previously,
          I led engineering teams at Stripe and Meta. I write here about AI,
          strategy, product, and the long arc of building things.
        </p>
        <div class="mt-8 flex items-center gap-6 font-sans text-sm">
          <a href="/writing/" class="text-accent no-underline hover:underline">Read the writing →</a>
          <a href="/about/" class="text-ink no-underline hover:text-accent">About me</a>
        </div>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="container-wide pb-24">
      <div class="flex items-end justify-between mb-2 border-b border-rule pb-3">
        <h2 class="font-sans text-sm tracking-[0.18em] uppercase text-muted">Recent Writing</h2>
        <a href="/writing/" class="font-sans text-sm text-ink no-underline hover:text-accent">All writing →</a>
      </div>
      <div class="divide-rule">
        {posts.map((post) => (
          <ArticleCard
            href={`/writing/${post.slug}/`}
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            topic={post.data.topic}
            readTime={readTime(post.body)}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
