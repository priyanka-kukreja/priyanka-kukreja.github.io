---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

function readTime(body: string) {
  const words = body.trim().split(/\s+/).length;
  return Math.max(1, Math.round(words / 220));
}
---

<BaseLayout
  title="Priyanka Kukreja"
  description="Redefining the software development lifecycle using Agentic AI. Product leader at CodeRabbit. Previously Stripe, Meta."
>
  <section class="container-wide pt-20 md:pt-28 pb-20">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16 items-center">
      <div class="md:col-span-4">
        <img
          src="/headshot.png"
          alt="Priyanka Kukreja"
          width="320"
          height="400"
          class="w-full max-w-[320px] aspect-[4/5] object-cover rounded-sm border border-rule"
        />
      </div>
      <div class="md:col-span-8">
        <p class="eyebrow mb-5">Product Leader · CodeRabbit</p>
        <h1 class="text-[2.6rem] md:text-[3.4rem] leading-[1.05] tracking-tight">
          Redefining Software Development with Agentic AI
        </h1>
        <p class="mt-7 text-lg md:text-xl text-ink/80 leading-relaxed max-w-2xl">
          I lead product at <a href="https://techcrunch.com/2025/09/16/coderabbit-raises-60m-valuing-the-2-year-old-ai-code-review-startup-at-550m/" target="_blank" rel="noopener noreferrer">CodeRabbit</a>,
          a Series-B AI developer tools startup. My team builds 0→1 products
          for engineers working with AI agents, compressing the path from idea
          to implementation from weeks to days. Previously, I was a Technical
          Leader at Stripe and a Machine Learning Engineer at Meta. I write about technology, AI, product strategy, and the little things that bring joy and make life worth living.
        </p>
        <div class="mt-8 flex items-center gap-6 font-sans text-sm">
          <a href="/writing/" class="text-accent no-underline hover:underline">Read the writing →</a>
          <a href="/about/" class="text-ink no-underline hover:text-accent">About me</a>
        </div>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="container-wide pb-24">
      <div class="flex items-end justify-between mb-2 border-b border-rule pb-3">
        <h2 class="font-sans text-sm tracking-[0.18em] uppercase text-muted">Recent Writing</h2>
        <a href="/writing/" class="font-sans text-sm text-ink no-underline hover:text-accent">All writing →</a>
      </div>
      <div class="divide-rule">
        {posts.map((post) => (
          <ArticleCard
            href={`/writing/${post.slug}/`}
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            topic={post.data.topic}
            readTime={readTime(post.body)}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
