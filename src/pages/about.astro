---
import BaseLayout from "../layouts/BaseLayout.astro";

const career = [
  {
    period: "Present",
    role: "Chief Product Officer",
    org: "CodeRabbit",
    note: "Leading product for a Series B AI company. Building 0→1 products that bring AI into the hands of engineers.",
  },
  {
    period: "Earlier",
    role: "Engineering Leader",
    org: "Stripe",
    note: "Led teams building financial infrastructure that powers global commerce — moving money across borders at internet scale.",
  },
  {
    period: "Earlier",
    role: "Engineering Leader",
    org: "Meta",
    note: "Led teams shipping ranking and recommendation systems to billions of people.",
  },
];

const education = [
  { school: "Carnegie Mellon University", degree: "M.S. Computer Science" },
  { school: "Carnegie Mellon University", degree: "M.S. Economics" },
  { school: "Undergraduate", degree: "B.S. Computer Science" },
];
---

<BaseLayout
  title="About"
  description="Priyanka Kukreja — Chief Product Officer at a Series B AI startup. Previously Stripe, Meta. CMU."
>
  <section class="container-prose pt-20 md:pt-24 pb-20">
    <p class="eyebrow mb-5">About</p>
    <h1 class="text-4xl md:text-5xl leading-[1.1] tracking-tight">
      Twenty-five years of shipping. Still building.
    </h1>

    <div class="prose-essay mt-10 text-lg">
      <p>
        I'm Priyanka Kukreja, Chief Product Officer at a Series B AI company.
        My team builds 0→1 products — taking the wild promise of large models
        and shaping it into tools real engineers can rely on every day.
      </p>
      <p>
        Before product, I spent years on the engineering side. At
        <strong>Stripe</strong>, I led teams building the financial
        infrastructure that moves money across borders. At <strong>Meta</strong>,
        I led ranking and recommendation systems serving billions. Those years
        taught me how to build durable systems — and, more importantly, how to
        build the teams that build them.
      </p>
      <p>
        I studied at <strong>Carnegie Mellon University</strong>, where I earned
        a B.S. in Computer Science, an M.S. in Computer Science, and an M.S. in
        Economics. The mix shapes how I think: systems on one shoulder, markets
        on the other.
      </p>

      <h2>What I think about</h2>
      <p>
        The questions that keep me up: How do you take an AI capability from
        demo to durable product? How do you stage a 0→1 roadmap without losing
        the magic? What does great product leadership look like in a world
        where the models change every quarter? I write about these here, along
        with strategy, technology, and the occasional note on the long arc of a
        career.
      </p>
    </div>
  </section>

  <section class="container-prose pb-20">
    <h2 class="font-sans text-sm tracking-[0.18em] uppercase text-muted border-b border-rule pb-3 mb-2">
      Selected Career
    </h2>
    <ul>
      {career.map((c) => (
        <li class="py-6 border-b border-rule grid grid-cols-12 gap-6">
          <div class="col-span-12 md:col-span-3 font-sans text-sm text-muted">{c.period}</div>
          <div class="col-span-12 md:col-span-9">
            <div class="text-xl">
              {c.role} <span class="text-muted">·</span> <span class="text-accent">{c.org}</span>
            </div>
            <p class="mt-2 text-ink/80 leading-relaxed">{c.note}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-prose pb-24">
    <h2 class="font-sans text-sm tracking-[0.18em] uppercase text-muted border-b border-rule pb-3 mb-2">
      Education
    </h2>
    <ul>
      {education.map((e) => (
        <li class="py-5 border-b border-rule grid grid-cols-12 gap-6">
          <div class="col-span-12 md:col-span-5 text-ink">{e.school}</div>
          <div class="col-span-12 md:col-span-7 text-muted">{e.degree}</div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
