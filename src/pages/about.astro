---
import BaseLayout from "../layouts/BaseLayout.astro";

const career = [
  {
    period: "2026–Present",
    role: "Staff Product Manager",
    org: "CodeRabbit",
    note: "Building Issue Planner, a 0→1 product designed to take human intent and generate AI-powered implementation plans. Work spans agentic AI, developer workflows, prompt engineering, explainability, and the future of AI-assisted software development.",
  },
  {
    period: "Earlier",
    role: "Technical Leader",
    org: "Stripe",
    note: "Led teams building the financial infrastructure that moves money across borders — global payments systems at internet scale.",
  },
  {
    period: "Earlier",
    role: "Machine Learning Engineer",
    org: "Meta",
    note: "Led AI-powered integrity systems tackling harmful content, fraud, and scams in digital communities for 3.5 billion users.",
  },
  {
    period: "Earlier",
    role: "Software Engineer",
    org: "Microsoft",
    note: "Built developer and cloud automation systems.",
  },
  {
    period: "Earlier",
    role: "Software Engineer",
    org: "GoDaddy",
    note: "Worked on domain auction pricing systems.",
  },
];

const education = [
  { school: "Carnegie Mellon University", degree: "M.S. Computer Science" },
  { school: "BITS - Pilani", degree: "M.S. Economics" },
  { school: "BITS - Pilani", degree: "B.E. Computer Science" },
];
---

<BaseLayout
  title="About"
  description="Priyanka Kukreja — Product Leader at CodeRabbit. Previously Stripe, Meta, Microsoft. CMU."
>
  <section class="container-prose pt-20 md:pt-24 pb-20">
    <p class="eyebrow mb-5">About</p>
    <h1 class="text-4xl md:text-5xl leading-[1.1] tracking-tight">
      Technical roots with Product mindset
    </h1>

    <div class="prose-essay mt-10 text-lg">
      <p>
        I'm the Product Leader at CodeRabbit, where I own the success of Issue
        Planner (one of CodeRabbit's flagship 0→1 bets) working directly with
        the COO to build this category-defining product. Issue Planner is
        designed to redefine how engineering teams move from human intent to
        AI-generated code: taking a ticket, a goal, or an ambiguous instruction,
        and turning it into a structured, reviewable plan that an AI agent can
        execute.
      </p>
      <p>
        Before product, I spent close to a decade on the engineering side. At
        <strong>Stripe</strong>, I led a team of engineers building financial
        infrastructure that moves money across borders at internet scale. At
        <strong>Meta</strong>, I built AI-powered integrity systems tackling
        harmful content, fraud, and scams at massive scale (The Indian Express
        profiled my work on making the virtual world safer). Earlier in my
        career, I worked at <strong>Microsoft</strong> on developer and cloud
        automation, and at <strong>GoDaddy</strong> on domain pricing systems.
      </p>
      <p>
        I hold a Master's in Computer Science from
        <strong>Carnegie Mellon University</strong>, where I specialized in
        Artificial Intelligence and Machine Learning. I also hold a Bachelor's
        in Computer Science and Master's in Economics from
        <strong>BITS - Pilani</strong>. This dual foundation in technology and
        business enables me to build products that are truly delightful to
        customers and shareholders alike.
      </p>

      <h2>What I think about</h2>
      <p>
        The questions that keep me up: How do you take an AI capability from
        demo to durable product? How do you stage a 0→1 roadmap without losing
        the magic? What does great product leadership look like in a world where
        the models change every quarter? I write about these here, along with
        strategy, technology, and the occasional note on the long arc of a
        career.
      </p>
    </div>
  </section>

  <section class="container-prose pb-20">
    <h2 class="font-sans text-sm tracking-[0.18em] uppercase text-muted border-b border-rule pb-3 mb-2">
      Selected Career
    </h2>
    <ul>
      {career.map((c) => (
        <li class="py-6 border-b border-rule grid grid-cols-12 gap-6">
          <div class="col-span-12 md:col-span-3 font-sans text-sm text-muted">{c.period}</div>
          <div class="col-span-12 md:col-span-9">
            <div class="text-xl">
              {c.role} <span class="text-muted">·</span> <span class="text-accent">{c.org}</span>
            </div>
            <p class="mt-2 text-ink/80 leading-relaxed">{c.note}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-prose pb-24">
    <h2 class="font-sans text-sm tracking-[0.18em] uppercase text-muted border-b border-rule pb-3 mb-2">
      Education
    </h2>
    <ul>
      {education.map((e) => (
        <li class="py-5 border-b border-rule grid grid-cols-12 gap-6">
          <div class="col-span-12 md:col-span-5 text-ink">{e.school}</div>
          <div class="col-span-12 md:col-span-7 text-muted">{e.degree}</div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
