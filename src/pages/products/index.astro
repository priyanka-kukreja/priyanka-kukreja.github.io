---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const products = (await getCollection("products", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Products"
  description="Things I'm building. Short descriptions and walkthroughs."
>
  <section class="container-wide pt-20 md:pt-24 pb-12">
    <p class="eyebrow mb-5">Products</p>
    <h1 class="text-4xl md:text-5xl leading-[1.1] tracking-tight">
      Things I'm building.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-ink/80 leading-relaxed">
      A running record of products I've built or am building — short writeups
      and short videos. New entries arrive as the work ships.
    </p>
  </section>

  <section class="container-wide pb-24">
    {products.length === 0 ? (
      <div class="border border-dashed border-rule rounded-sm p-10 md:p-16 text-center">
        <p class="font-sans text-sm tracking-[0.18em] uppercase text-muted">In progress</p>
        <p class="mt-4 text-2xl leading-snug max-w-xl mx-auto">
          Documenting the products I build. More soon.
        </p>
        <p class="mt-6 font-sans text-sm">
          <a href="/contact/" class="text-accent no-underline hover:underline">Get notified →</a>
        </p>
      </div>
    ) : (
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-10">
        {products.map(async (p) => {
          const formatted = p.data.date.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
          });
          return (
            <li class="border-t border-rule pt-6">
              <p class="eyebrow mb-3">{formatted}</p>
              <h3 class="text-2xl">{p.data.title}</h3>
              <p class="mt-3 text-ink/80 leading-relaxed">{p.data.description}</p>
              {p.data.loomUrl ? (
                <div class="mt-5 aspect-video w-full border border-rule">
                  <iframe
                    src={p.data.loomUrl.replace("/share/", "/embed/")}
                    title={`${p.data.title} — walkthrough`}
                    frameborder="0"
                    allowfullscreen
                    class="w-full h-full"
                  />
                </div>
              ) : null}
              {p.data.link ? (
                <a class="mt-5 inline-block font-sans text-sm text-accent no-underline hover:underline" href={p.data.link} target="_blank" rel="noopener">Visit →</a>
              ) : null}
            </li>
          );
        })}
      </ul>
    )}
  </section>
</BaseLayout>
