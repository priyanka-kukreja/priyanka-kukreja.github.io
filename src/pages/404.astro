    <p class="eyebrow mb-5">404</p>
    <h1 class="text-4xl md:text-5xl leading-[1.1] tracking-tight">
      That page doesn't exist.
    </h1>
    <p class="mt-6 text-lg text-ink/80">
      Try the <a href="/writing/">writing</a> or head <a href="/">home</a>.
    </p>
  </section>
</BaseLayout>
