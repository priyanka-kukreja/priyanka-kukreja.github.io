---
interface Props {
  href: string;
  title: string;
  description?: string;
  date: Date;
  topic: string;
  readTime?: number;
}
const { href, title, description, date, topic, readTime } = Astro.props;
const formatted = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="group py-7 border-b border-rule">
  <a href={href} class="block no-underline">
    <div class="eyebrow mb-2 flex items-center gap-3">
      <span>{topic}</span>
      <span aria-hidden="true">·</span>
      <time datetime={date.toISOString()}>{formatted}</time>
      {readTime ? (
        <>
          <span aria-hidden="true">·</span>
          <span>{readTime} min read</span>
        </>
      ) : null}
    </div>
    <h3 class="text-2xl leading-snug text-ink group-hover:text-accent transition-colors">
      {title}
    </h3>
    {description ? (
      <p class="mt-2 text-ink/80 leading-relaxed">{description}</p>
    ) : null}
  </a>
</article>
